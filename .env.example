# 登入密碼。正式環境請換成至少 8 碼、且不可使用 change-me。
SITE_PASSWORD=change-me

# 簽章 session cookie。正式環境請換成至少 16 碼的隨機字串。
SESSION_SECRET=change-me-session-secret

# session 有效時數，預設 12。
SESSION_HOURS=12

# file（預設，讀檔案／網址／推送快照）或 okx（預留的唯讀介面）。
DATA_SOURCE=file

# 選填。本機檔案路徑，或 http(s) 網址。
# 留空時：若有推送快照就用快照，否則用內建範例資料。
LEADERBOARD_SOURCE=

# POST /api/ingest 寫入的快照路徑。此檔已在 .gitignore。
INGEST_STORE_PATH=data/live-leaderboard.json

# 有設定才會開啟推送端點。正式環境至少 16 碼。產生方式：openssl rand -base64 32
INGEST_TOKEN=

# 瀏覽器自動重新整理間隔（毫秒），預設 15000，範圍 5000–300000。
POLL_MS=15000

# --- 以下僅在 DATA_SOURCE=okx 時由伺服器讀取。不要加 NEXT_PUBLIC_ 前綴。 ---
# 1 表示模擬盤（預設）。設為 0 才會標成實盤。程式目前不會連線到 OKX。
OKX_SIMULATED=1

OKX_DEFENSE_API_KEY=
OKX_DEFENSE_SECRET_KEY=
OKX_DEFENSE_PASSPHRASE=

OKX_CONSERVATIVE_API_KEY=
OKX_CONSERVATIVE_SECRET_KEY=
OKX_CONSERVATIVE_PASSPHRASE=

OKX_AGGRESSIVE_API_KEY=
OKX_AGGRESSIVE_SECRET_KEY=
OKX_AGGRESSIVE_PASSPHRASE=

OKX_FANATIC_API_KEY=
OKX_FANATIC_SECRET_KEY=
OKX_FANATIC_PASSPHRASE=
